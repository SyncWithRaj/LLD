      "link": null,
      "locked": false,
      "text": "Principle of Least Knowledge",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Principle of Least Knowledge",
      "autoResize": true,
