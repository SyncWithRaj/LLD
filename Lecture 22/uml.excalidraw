    {
      "id": "VNEDCNr5nnxnmv76ktlRm",
      "type": "text",
      "x": 467.4731405,
      "y": 1608.332789864362,
      "width": 570.8275146484375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cJYb",
      "roundness": null,
      "seed": 2104746073,
      "version": 516,
      "versionNonce": 473649999,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785590800618,
      "link": null,
      "locked": false,
      "text": "Principle of Least Knowledge (Rules):\n\nTake any object, now from any method in that Object,\nprinciple tells you tu invoke only methods that belongs to:\n- The Object iteself\n- the Object passed in as a parameter to the method.\n- Any Object that method Creates\n- Any Object with (HAS-A) relation?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Principle of Least Knowledge (Rules):\n\nTake any object, now from any method in that Object, principle tells you tu invoke only methods that belongs to:\n- The Object iteself\n- the Object passed in as a parameter to the method.\n- Any Object that method Creates\n- Any Object with (HAS-A) relation?",
      "autoResize": false,
      "lineHeight": 1.25
    },
