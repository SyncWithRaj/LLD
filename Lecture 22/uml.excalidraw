      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Adapter converts the interface of a class into another interface that client expects. Adapter lets classes work together that could 'nt, Otherwise because of incompatible interface.",
      "autoResize": false,
      "lineHeight": 1.25
    },
