      "index": "cLll",
      "roundness": null,
      "seed": 631375307,
      "version": 385,
      "versionNonce": 1906274156,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786038602484,
      "link": null,
      "locked": false,
      "text": "Adapter converts the interface of a class into another interface\nthat client expects. Adapter lets classes work together that\ncould 'nt, Otherwise because of incompatible interface.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Adapter converts the interface of a class into another interface that client expects. Adapter lets classes work together that could 'nt, Otherwise because of incompatible interface.",
      "autoResize": false,
      "lineHeight": 1.25
    },
